# Optional Gemini generation. Retrieval and fallback work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Set to 1 to enable spaCy sentence segmentation. The default keeps API imports
# lightweight and uses the deterministic sentence fallback.
ENABLE_SPACY=0

# Optional override for local deployment.
DATABASE_URL=sqlite:///./researchpilot.db
